# Copy to deploy/.env on the server and fill in. Never commit the real .env.

# The address players connect to. Point its DNS A record at this server first.
DOMAIN=play.your-domain.in

# Database password: letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Google sign-in: the "Web application" OAuth client ID (comma-separate several if needed).
# Leave empty to allow guest play only.
GOOGLE_CLIENT_IDS=

# Optional tuning
# TURN_SECONDS=30
# DISCONNECT_GRACE_SECONDS=60
