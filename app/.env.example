# Copy to app/.env for development builds. Store builds take these from eas.json instead.

# The game server. Leave unset in development to type the address on the sign-in screen.
# EXPO_PUBLIC_SERVER_URL=https://play.your-domain.in

# Google Cloud > APIs & Services > Credentials > OAuth client ID of type "Web application".
# Google sign-in only works in real builds (EAS), not in Expo Go.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
